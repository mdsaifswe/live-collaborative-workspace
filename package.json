{
  "name": "live-collaborative-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "start:server": "tsx src/server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings=0",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:collaboration": "playwright test tests/e2e/collaboration.spec.ts",
    "bench": "tsx tests/benchmark/browser-benchmark.ts",
    "bench:transport": "tsx tests/benchmark/run-benchmark.ts",
    "measure": "tsx tests/benchmark/browser-benchmark.ts",
    "a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run bench && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "axe-core": "^4.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.15.0",
    "playwright": "^1.50.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
